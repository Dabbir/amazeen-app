{
  "name": "amazeen",
  "version": "1.3.0",
  "description": "AMAZEEN \u2014 the weekly magazine of your own life.",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build && npm run db:local && wrangler pages dev dist --d1 DB=local-amazeen --local --port 8788 --compatibility-date=2026-11-01",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml --persist-to .wrangler/state",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dabbir/amazeen-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Dabbir/amazeen-app/issues"
  },
  "homepage": "https://github.com/Dabbir/amazeen-app#readme",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.164.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
